<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="860.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.ConsultaClientesViewController">
   <children>
      <Label text="Consultar clientes">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Buscar por identificación:" />
            <TextField fx:id="txtBuscar" prefWidth="160.0" />
            <Button fx:id="btnBuscar" onAction="#onBuscar" text="Buscar" />
            <Button fx:id="btnVerTodos" onAction="#onVerTodos" text="Ver todos" />
         </children>
      </HBox>
      <TableView fx:id="tblListCliente" prefHeight="260.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tbcIdentificacion" prefWidth="130.0" text="Identificación" />
            <TableColumn fx:id="tbcNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="tbcCorreo" prefWidth="250.0" text="Correo" />
            <TableColumn fx:id="tbcTipo" prefWidth="130.0" text="Tipo" />
            <TableColumn fx:id="tbcCompras" prefWidth="100.0" text="Compras" />
         </columns>
      </TableView>
      <HBox alignment="CENTER">
         <children>
            <Button fx:id="btnVolver" onAction="#onVolver" prefWidth="120.0" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
