<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="340.0" prefWidth="440.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.MenuCineViewController">
   <children>
      <Label text="Menú del cine">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button fx:id="btnAdministradores" onAction="#onAdministradores" prefWidth="260.0" text="Gestión de administradores" />
      <Button fx:id="btnOperarios" onAction="#onOperarios" prefWidth="260.0" text="Gestión de operarios" />
      <Button fx:id="btnClientes" onAction="#onClientes" prefWidth="260.0" text="Consultar clientes" />
      <Button fx:id="btnVolver" onAction="#onVolver" prefWidth="260.0" text="Volver" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
