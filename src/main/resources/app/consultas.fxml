<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="860.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.ConsultaViewController">
   <children>
      <Label text="Consultar películas y funciones">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="Películas">
               <content>
                  <TableView fx:id="tblListPelicula">
                     <columns>
                        <TableColumn fx:id="tbcPCodigo" prefWidth="80.0" text="Código" />
                        <TableColumn fx:id="tbcPNombre" prefWidth="240.0" text="Nombre" />
                        <TableColumn fx:id="tbcPGenero" prefWidth="100.0" text="Género" />
                        <TableColumn fx:id="tbcPDuracion" prefWidth="90.0" text="Duración" />
                        <TableColumn fx:id="tbcPClasificacion" prefWidth="130.0" text="Clasificación" />
                        <TableColumn fx:id="tbcPEstado" prefWidth="130.0" text="Estado" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Funciones programadas">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Fecha:" />
                              <DatePicker fx:id="dpFecha" promptText="dd/mm/aaaa" />
                              <Button fx:id="btnFiltrar" onAction="#onFiltrar" text="Filtrar por fecha" />
                              <Button fx:id="btnVerTodas" onAction="#onVerTodas" text="Ver todas" />
                           </children>
                           <padding>
                              <Insets left="8.0" top="8.0" />
                           </padding>
                        </HBox>
                        <TableView fx:id="tblListFuncion" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="tbcFCodigo" prefWidth="70.0" text="Código" />
                              <TableColumn fx:id="tbcFPelicula" prefWidth="210.0" text="Película" />
                              <TableColumn fx:id="tbcFSala" prefWidth="80.0" text="Sala" />
                              <TableColumn fx:id="tbcFFecha" prefWidth="110.0" text="Fecha" />
                              <TableColumn fx:id="tbcFHora" prefWidth="70.0" text="Hora" />
                              <TableColumn fx:id="tbcFValor" prefWidth="100.0" text="Valor base" />
                              <TableColumn fx:id="tbcFLibres" prefWidth="100.0" text="Libres" />
                              <TableColumn fx:id="tbcFOcupados" prefWidth="100.0" text="Ocupados" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <HBox alignment="CENTER">
         <children>
            <Button fx:id="btnVolver" onAction="#onVolver" prefWidth="120.0" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
