<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="820.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.DisponibilidadViewController">
   <children>
      <Label text="Disponibilidad de asientos">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Función:" />
            <ComboBox fx:id="cmbFuncion" onAction="#onFuncionElegida" prefWidth="480.0" />
         </children>
      </HBox>
      <HBox spacing="24.0">
         <children>
            <Label text="Total asientos:" />
            <Label fx:id="lblTotal" text="-" />
            <Label text="Libres:" />
            <Label fx:id="lblLibres" text="-" />
            <Label text="Ocupados:" />
            <Label fx:id="lblOcupados" text="-" />
            <Label text="Ocupación:" />
            <Label fx:id="lblOcupacion" text="-" />
         </children>
      </HBox>
      <Label text="(X) = ocupado" />
      <Label alignment="CENTER" maxWidth="Infinity" text="PANTALLA" />
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <GridPane fx:id="gridAsientos" hgap="6.0" vgap="6.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </GridPane>
         </content>
      </ScrollPane>
      <HBox alignment="CENTER">
         <children>
            <Button fx:id="btnVolver" onAction="#onVolver" prefWidth="120.0" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
