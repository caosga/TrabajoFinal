<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="620.0" prefWidth="1000.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.VentaViewController">
   <children>
      <Label text="Vender entradas">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox spacing="24.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefWidth="380.0" spacing="12.0">
               <children>
                  <Label text="Función:" />
                  <ComboBox fx:id="cmbFuncion" maxWidth="Infinity" onAction="#onFuncionElegida" />
                  <Label text="Operario que vende:" />
                  <ComboBox fx:id="cmbOperario" maxWidth="Infinity" />
                  <Label text="Cliente:" />
                  <ComboBox fx:id="cmbCliente" maxWidth="Infinity" onAction="#onClienteElegido" />
                  <Label text="Tipo de entrada:" />
                  <ComboBox fx:id="cmbTipo" maxWidth="Infinity" onAction="#onTipoElegido" />
                  <HBox spacing="8.0">
                     <children>
                        <Label text="Asientos elegidos:" />
                        <Label fx:id="lblAsiento" text="Ninguno">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox spacing="8.0">
                     <children>
                        <Label text="Valor total:" />
                        <Label fx:id="lblValor" text="-">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Button fx:id="btnVender" onAction="#onVender" text="Registrar venta" />
                        <Button fx:id="btnLimpiar" onAction="#onLimpiar" text="Limpiar" />
                        <Button fx:id="btnVolver" onAction="#onVolver" text="Volver" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Haga clic en uno o varios asientos ((X) = ocupado, * = elegido; clic otra vez para quitarlo)" wrapText="true" />
                  <Label alignment="CENTER" maxWidth="Infinity" text="PANTALLA" />
                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                     <content>
                        <GridPane fx:id="gridAsientos" hgap="6.0" vgap="6.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </GridPane>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
