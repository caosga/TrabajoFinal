<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="940.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.CancelarVentaViewController">
   <children>
      <Label text="Cancelar venta">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label text="Seleccione una venta ACTIVA de la tabla y presione Cancelar venta. Sus asientos quedan libres y la venta se conserva como CANCELADA." />
      <TableView fx:id="tblListVenta" prefHeight="360.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tbcCodigo" prefWidth="70.0" text="Código" />
            <TableColumn fx:id="tbcCliente" prefWidth="130.0" text="Cliente" />
            <TableColumn fx:id="tbcPelicula" prefWidth="170.0" text="Película" />
            <TableColumn fx:id="tbcFuncion" prefWidth="130.0" text="Función" />
            <TableColumn fx:id="tbcAsiento" prefWidth="110.0" text="Asientos" />
            <TableColumn fx:id="tbcTipo" prefWidth="110.0" text="Tipo" />
            <TableColumn fx:id="tbcValor" prefWidth="80.0" text="Valor" />
            <TableColumn fx:id="tbcEstado" prefWidth="90.0" text="Estado" />
         </columns>
      </TableView>
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button fx:id="btnCancelarVenta" onAction="#onCancelarVenta" text="Cancelar venta" />
            <Button fx:id="btnVolver" onAction="#onVolver" prefWidth="120.0" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
