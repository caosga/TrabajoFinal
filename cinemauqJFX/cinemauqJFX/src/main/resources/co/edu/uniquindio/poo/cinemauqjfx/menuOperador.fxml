<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="440.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.cinemauqjfx.viewController.MenuOperadorViewController">
   <children>
      <Label text="Menú del operador">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button fx:id="btnClientes" onAction="#onClientes" prefWidth="280.0" text="Registrar cliente" />
      <Button fx:id="btnVender" onAction="#onVender" prefWidth="280.0" text="Vender entrada" />
      <Button fx:id="btnCancelarVenta" onAction="#onCancelarVenta" prefWidth="280.0" text="Cancelar venta" />
      <Button fx:id="btnConsultas" onAction="#onConsultas" prefWidth="280.0" text="Consultar películas y funciones" />
      <Button fx:id="btnDisponibilidad" onAction="#onDisponibilidad" prefWidth="280.0" text="Disponibilidad de asientos" />
      <Button fx:id="btnVolver" onAction="#onVolver" prefWidth="280.0" text="Volver" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
